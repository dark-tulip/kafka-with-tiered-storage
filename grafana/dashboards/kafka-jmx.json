  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Remote log size (total)",
      "description": "Суммарный размер логов, которые Kafka считает уже выгруженными в удалённое хранилище (RemoteLogSizeBytes). Помогает понимать, сколько данных реально лежит в S3/MinIO.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotelogsizebytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Remote log size over time",
      "description": "Динамика суммарного размера логов в удалённом хранилище. Рост показывает, что offload работает и сегменты улетают в S3/MinIO.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotelogsizebytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Remote log metadata count",
      "description": "Количество записей метаданных remote-логов. Чем больше сегментов выгружено в удалённое хранилище, тем выше это значение.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotelogmetadatacount"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Remote log metadata count over time",
      "description": "Как меняется количество remote-метаданных во времени. Удобно смотреть, когда именно начинался/останавливался offload по сегментам.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotelogmetadatacount"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
