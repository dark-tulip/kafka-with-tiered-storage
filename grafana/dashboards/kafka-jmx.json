    {
      "id": 13,
      "type": "timeseries",
      "title": "Bytes in / out (broker total rate)",
      "description": "Трафик по брокеру: скорость входящих и исходящих байтов. Основа для понимания нагрузки и подсчёта пропускной способности.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(kafka_broker_bytes_total{direction=\"BytesInPerSec\"}[5m])",
          "legendFormat": "bytes_in/s"
        },
        {
          "refId": "B",
          "expr": "rate(kafka_broker_bytes_total{direction=\"BytesOutPerSec\"}[5m])",
          "legendFormat": "bytes_out/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
