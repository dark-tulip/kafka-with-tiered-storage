        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "RemoteLogManager idle %",
      "description": "Средний процент простоя задач RemoteLogManager. Близко к 100% — нормально (работает редко). Если долго держится низко — RLM постоянно занят.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotelogmanagertasksavgidlepercent * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Copy lag (bytes & segments)",
      "description": "Лаг копирования в удалённое хранилище: сколько байт и сегментов ещё не выгружено. Рост лагов значит, что remote-копирование не успевает.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotecopylagbytes",
          "legendFormat": "copy lag bytes"
        },
        {
          "refId": "B",
          "expr": "kafka_remotecopylagsegments",
          "legendFormat": "copy lag segments"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Delete lag (bytes & segments)",
      "description": "Лаг удаления сегментов из удалённого хранилища. Если лаг растёт, то чистка удалённого сториджа отстаёт от политик ретенции.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotedeletelagbytes",
          "legendFormat": "delete lag bytes"
        },
        {
          "refId": "B",
          "expr": "kafka_remotedeletelagsegments",
          "legendFormat": "delete lag segments"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Remote log size computation time",
      "description": "Время, которое Kafka тратит на вычисление размера remote-логов. Если становится заметно большим — может быть индикатором просадок в метаданных или S3.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_remotelogsizecomputationtime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "seconds",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
